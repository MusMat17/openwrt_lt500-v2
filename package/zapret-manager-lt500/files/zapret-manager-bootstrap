#!/bin/sh /etc/rc.common
START=99

start() {
	# Keep enabled: the installer checksum detects a newer panel package or a
	# preserved RC1 dashboard after sysupgrade. No downloads are needed here.
	(
		sleep 15
		if /usr/libexec/lt500-panel-apply >/tmp/zapret-manager-bootstrap.log 2>&1; then
			logger -t zapret-manager-bootstrap 'LT500 panel is ready'
		else
			logger -t zapret-manager-bootstrap 'Panel installation deferred or failed; see /tmp/zapret-manager-bootstrap.log'
		fi
	) &
}
